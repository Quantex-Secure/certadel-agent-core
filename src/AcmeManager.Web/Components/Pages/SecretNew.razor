@page "/settings/secrets/new"
@rendermode InteractiveServer
@inject SecretsService SecretsSvc
@inject NavigationManager Nav
@using System.ComponentModel.DataAnnotations
@using AcmeManager.Core.Security

<PageTitle>New secret — Certadel Agent</PageTitle>

<h2 class="mb-3">New secret</h2>

<div class="card">
    <div class="card-body" style="max-width: 32rem">
        <EditForm Model="Form" OnValidSubmit="SubmitAsync" FormName="newSecret">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="Form.Name"
                           placeholder="e.g. cloudflare-prod-token" />
                <div class="form-text">Plugin options reference this by name. If a secret already exists with this name, its value is replaced.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Value</label>
                <InputText type="password" class="form-control" @bind-Value="Form.Value"
                           autocomplete="new-password" />
                <div class="form-text">Stored encrypted at rest. You won't be able to view this again — make sure you have a copy elsewhere.</div>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_busy">
                @(_busy ? "Saving…" : "Save")
            </button>
            <a href="/settings/secrets" class="btn btn-outline-secondary">Cancel</a>
        </EditForm>
    </div>
</div>

@code {
    // See AccountNew.razor for why this is `= default!` plus OnInitialized init.
    [SupplyParameterFromForm]
    public FormModel Form { get; set; } = default!;

    private bool _busy;
    private string? _error;

    protected override void OnInitialized() => Form ??= new FormModel();

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            await SecretsSvc.CreateOrReplaceAsync(Form.Name, Form.Value);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
            return;
        }

        // NavigateTo outside try/catch — see AccountNew.razor for why.
        _busy = false;
        Nav.NavigateTo("/settings/secrets");
    }

    public sealed class FormModel
    {
        [Required, StringLength(128, MinimumLength = 1)]
        public string Name { get; set; } = "";

        [Required, StringLength(8192, MinimumLength = 1)]
        public string Value { get; set; } = "";
    }
}
