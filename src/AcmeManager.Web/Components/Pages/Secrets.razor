@page "/settings/secrets"
@rendermode InteractiveServer
@inject IDbContextFactory<AcmeManagerDbContext> DbFactory
@inject SecretsService SecretsSvc
@using AcmeManager.Core.Security
@using AcmeManager.Core.Storage
@using AcmeManager.Core.Storage.Entities
@using Microsoft.EntityFrameworkCore

<PageTitle>Secrets — Certadel Agent</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb"><li class="breadcrumb-item"><a href="/settings">Settings</a></li><li class="breadcrumb-item active">Secrets</li></ol>
</nav>
<div class="d-flex align-items-center mb-3">
    <h2 class="mb-0">Secrets</h2>
    <a class="btn btn-primary ms-auto" href="/settings/secrets/new">+ New secret</a>
</div>

<p class="text-muted small">
    Secrets are referenced by name from plugin options (e.g. Cloudflare API tokens).
    Values are encrypted at rest and never re-displayed after creation.
</p>

@if (_secrets is null)
{
    <p class="text-muted">Loading…</p>
}
else if (_secrets.Count == 0)
{
    <div class="card">
        <div class="card-body text-muted">No secrets stored yet.</div>
    </div>
}
else
{
    <div class="card">
        <table class="table table-sm m-0">
            <thead>
                <tr><th>Name</th><th>Created</th><th>Last used</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in _secrets)
                {
                    <tr>
                        <td><code>@s.Name</code></td>
                        <td class="small text-muted">@s.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="small text-muted">@(s.LastUsedAt is null ? "—" : s.LastUsedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm"))</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(s.Name)"
                                    @onclick:preventDefault>Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Secret>? _secrets;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var list = await db.Secrets.AsNoTracking().ToListAsync();
        _secrets = list.OrderBy(s => s.Name).ToList();
    }

    private async Task Delete(string name)
    {
        await SecretsSvc.DeleteAsync(name);
        await LoadAsync();
    }
}
